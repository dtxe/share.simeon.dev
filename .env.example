# --- Postgres ---
# Password is NOT set here — it comes from the docker secret file
# ./secrets/postgres_password.txt (see docker-compose.yml `secrets:` block).
# Both the postgres container (POSTGRES_PASSWORD_FILE) and the backend
# (DB_PASSWORD_FILE, used to build DATABASE_URL) read the same file.
POSTGRES_DB=share
POSTGRES_USER=share_app

# --- Redis (rate limits + LLM spend cap only, no identity data) ---
REDIS_URL=redis://redis:6379/0

# --- HTTP ---
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173
TRUSTED_PROXY=false
# When TRUSTED_PROXY=true, set this to the header your proxy attests the real
# client address with (e.g. CF-Connecting-IP behind Cloudflare). Empty falls
# back to the last hop of X-Forwarded-For. Leave unset in dev (no proxy).
# REAL_IP_HEADER=CF-Connecting-IP

# --- Identity ---
ANON_ACCOUNTS_ENABLED=true
ANON_IDENTITY_TRANSPORT=cookie
ANON_SESSION_COOKIE_NAME=share_sid
ANON_SESSION_HEADER_NAME=X-Anon-Session-Token
ANON_SESSION_TTL_DAYS=30
SESSION_TOUCH_MIN_INTERVAL_HOURS=24

PASSKEY_ACCOUNTS_ENABLED=false
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Share
PASSKEY_ORIGIN=http://localhost:5173

EMAIL_OTP_ENABLED=true
OTP_CODE_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_RATE_PER_IP_PER_HOUR=10
# OTP_HASH_PEPPER is NOT set here — it comes from ./secrets/otp_hash_pepper.txt
# and is required when EMAIL_OTP_ENABLED=true.

# --- Email (real SMTP required in every environment) ---
# SMTP_PASS is NOT set here — it comes from ./secrets/smtp_pass.txt
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_FROM=

# --- LLM (receipt extraction) ---
# LLM_API_KEY is NOT set here — it comes from the docker secret file
# ./secrets/llm_api_key.txt (empty by default; fill it in to enable extraction).
# Built-in pricing is used for supported Fireworks models when the split cost
# env vars are unset. Supported models:
# - accounts/fireworks/models/minimax-m3: input 0.03, output 0.12 cents/1K tokens
# - accounts/fireworks/models/kimi-k2p7-code: input 0.095, output 0.4 cents/1K tokens
LLM_PROVIDER=fireworks
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/minimax-m3
# Set both only for custom models without built-in pricing.
# LLM_INPUT_COST_PER_1K_TOKENS_CENTS=
# LLM_OUTPUT_COST_PER_1K_TOKENS_CENTS=
LLM_DAILY_SPEND_CAP_CENTS=100
LLM_MAX_SPEND_PER_RECEIPT_CENTS=5

# --- CROP_LLM (Qwen VLM receipt-boundary detection, benchmark-only) ---
# Receipt-boundary crop detection uses a separate VLM via the
# image_crop_preprocess extraction strategy in extractbench only.
# THIS IS NOT WIRED INTO THE PRODUCTION SERVER.
# All five CROP_LLM_* vars must be explicitly set when using this strategy;
# they are loaded into config fields by a bench-only code path and are never
# required or used by the production server.
#
# WARNING — exact availability / tool-calling support / pricing for Fireworks'
# hosted Qwen-VL (or any VLM) must be confirmed independently before use.
# The 512-token generation budget for the detect_receipt_boundary tool call
# may need tuning for your specific model.
# CROP_LLM_BASE_URL=
# CROP_LLM_MODEL=
# CROP_LLM_API_KEY=
# CROP_LLM_INPUT_COST_PER_1K_TOKENS_CENTS=
# CROP_LLM_OUTPUT_COST_PER_1K_TOKENS_CENTS=

# --- Uploads ---
UPLOAD_DIR=/data/uploads

# --- Postgres ---
POSTGRES_DB=cher
POSTGRES_USER=cher_app
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://cher_app:changeme@postgres:5432/cher?sslmode=disable

# --- Redis (rate limits + LLM spend cap only, no identity data) ---
REDIS_URL=redis://redis:6379/0

# --- HTTP ---
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173
TRUSTED_PROXY=false

# --- Identity ---
ANON_ACCOUNTS_ENABLED=true
ANON_IDENTITY_TRANSPORT=cookie
ANON_SESSION_COOKIE_NAME=cher_sid
ANON_SESSION_HEADER_NAME=X-Anon-Session-Token
ANON_SESSION_TTL_DAYS=730
SESSION_TOUCH_MIN_INTERVAL_HOURS=24

PASSKEY_ACCOUNTS_ENABLED=false
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Cher
PASSKEY_ORIGIN=http://localhost:5173

EMAIL_OTP_ENABLED=true
OTP_CODE_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_RATE_PER_IP_PER_HOUR=10

# --- Email (dev default: mailpit, no real credentials needed) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_FROM=cher@localhost

# --- LLM (receipt extraction) ---
LLM_PROVIDER=fireworks
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/kimi-k2p7-code
LLM_API_KEY=
LLM_COST_PER_1K_TOKENS_CENTS=0.2
LLM_DAILY_SPEND_CAP_CENTS=100

# --- Uploads ---
UPLOAD_DIR=/data/uploads
